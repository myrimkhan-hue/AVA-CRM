# Локальные значения-примеры. Замените пароль перед внешним развёртыванием.
POSTGRES_DB=ava_crm
POSTGRES_USER=ava_crm
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432
BACKEND_PORT=3000
FRONTEND_PORT=5173

# Для запуска backend вне Docker:
DATABASE_URL=postgresql://ava_crm:change-me@localhost:5432/ava_crm?schema=public
PORT=3000
JWT_SECRET=replace-with-a-long-random-secret

# Опционально: начальный администратор для Prisma seed.
ADMIN_SEED_EMAIL=admin@example.com
ADMIN_SEED_PASSWORD=replace-with-a-strong-password

# Опционально: интеграция WhatsApp через Wazzup (раздел 4.6.1 ТЗ). Без них экраны WhatsApp
# работают в режиме "не настроено" — история сообщений видна, отправка недоступна.
WAZZUP_API_KEY=
WAZZUP_CHANNEL_ID=
# Придумайте длинную случайную строку — она же прописывается в Wazzup как часть URL вебхука
# (https://ваш-домен/api/webhooks/wazzup/ЗНАЧЕНИЕ).
WAZZUP_WEBHOOK_SECRET=

# Приём заявок с сайта ava-solution.kz (раздел 4.6.3 ТЗ). Придумайте длинную случайную
# строку — этим же значением сайт подписывает каждый запрос (HMAC-SHA256 от тела запроса,
# заголовок X-Signature, hex). Без неё endpoint отклоняет все запросы.
WEBSITE_LEADS_WEBHOOK_SECRET=

# Файловое хранилище (раздел 4.5 ТЗ). Максимальный размер одного файла в мегабайтах;
# по умолчанию 25. Папка хранения задаётся автоматически в docker-compose (том uploads_data),
# менять UPLOADS_DIR нужно только при запуске без Docker.
MAX_UPLOAD_MB=25
