generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  RESTORE
}

enum ContractorType {
  CLIENT
  CARRIER
  CUSTOMS_BROKER
  WAREHOUSE
  SUPPLIER
  OTHER
}

enum PaymentTerm {
  PREPAYMENT
  POSTPAYMENT
}

model User {
  id           String      @id @default(cuid())
  fullName     String      @map("full_name")
  email        String      @unique
  phone        String?
  passwordHash String      @map("password_hash")
  departmentId String?     @map("department_id")
  isActive     Boolean     @default(true) @map("is_active")
  createdAt    DateTime    @default(now()) @map("created_at")
  updatedAt    DateTime    @updatedAt @map("updated_at")
  department   Department? @relation(fields: [departmentId], references: [id])
  roles        UserRole[]
  auditLogs    AuditLog[]

  @@map("users")
}

model Role {
  id    String     @id @default(cuid())
  code  String     @unique
  name  String
  users UserRole[]

  @@map("roles")
}

model UserRole {
  id     String @id @default(cuid())
  userId String @map("user_id")
  roleId String @map("role_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@map("user_roles")
}

model Department {
  id    String @id @default(cuid())
  name  String @unique
  users User[]

  @@map("departments")
}

model LegalEntity {
  id              String   @id @default(cuid())
  name            String
  numberingPrefix String   @unique @map("numbering_prefix")
  bin             String?
  legalAddress    String?  @map("legal_address")
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@map("legal_entities")
}

model AuditLog {
  id          String      @id @default(cuid())
  actorUserId String?     @map("actor_user_id")
  entityType  String      @map("entity_type")
  entityId    String      @map("entity_id")
  action      AuditAction
  changes     Json?
  createdAt   DateTime    @default(now()) @map("created_at")
  actorUser   User?       @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@map("audit_logs")
}

model Contractor {
  id              String                  @id @default(cuid())
  name            String
  types           ContractorType[]
  bin             String?
  country         String?
  legalAddress    String?                 @map("legal_address")
  paymentTerm     PaymentTerm?            @map("payment_term")
  postpaymentDays Int?                    @map("postpayment_days")
  notes           String?
  isProblem       Boolean                 @default(false) @map("is_problem")
  problemComment  String?                 @map("problem_comment")
  isBlacklisted   Boolean                 @default(false) @map("is_blacklisted")
  blacklistReason String?                 @map("blacklist_reason")
  deletedAt       DateTime?               @map("deleted_at")
  createdAt       DateTime                @default(now()) @map("created_at")
  updatedAt       DateTime                @updatedAt @map("updated_at")
  contacts        ContractorContact[]
  bankAccounts    ContractorBankAccount[]

  @@map("contractors")
}

model ContractorContact {
  id           String     @id @default(cuid())
  contractorId String     @map("contractor_id")
  fullName     String     @map("full_name")
  position     String?
  phone        String?
  email        String?
  whatsapp     String?
  contractor   Contractor @relation(fields: [contractorId], references: [id], onDelete: Cascade)

  @@map("contractor_contacts")
}

model ContractorBankAccount {
  id            String     @id @default(cuid())
  contractorId  String     @map("contractor_id")
  bankName      String     @map("bank_name")
  accountNumber String     @map("account_number")
  currency      String
  notes         String?
  contractor    Contractor @relation(fields: [contractorId], references: [id], onDelete: Cascade)

  @@map("contractor_bank_accounts")
}
