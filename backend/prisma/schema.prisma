generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  RESTORE
}

enum TaxRegime {
  GENERAL
  SIMPLIFIED
  OTHER
}

enum TaxRateKind {
  VAT
  INCOME_TAX
}

enum RateSource {
  NBRK_AUTO
  MANUAL
}

enum InvoiceStatus {
  ISSUED
  PARTIALLY_PAID
  PAID
}

enum PaymentRequestStatus {
  REQUESTED
  APPROVED
  PAID
}

enum NotificationType {
  RESPONSIBLE_ASSIGNED
  DEAL_STALLED
  INVOICE_OVERDUE
  PAYMENT_REQUEST_PENDING
  TRANSPORTATION_OVERDUE
  WEBSITE_LEAD_RECEIVED
}

enum LeadStatus {
  NEW
  IN_PROGRESS
  CALL_BACK
  NOT_REACHED
  NOT_INTERESTED
  CONVERTED
}

enum LeadNotInterestedReason {
  NOT_NEEDED
  HAS_PROVIDER
  EXPENSIVE
  WRONG_CONTACT
  OTHER
}

enum LeadSource {
  COLD_CALL_IMPORT
  WEBSITE
}

enum ContractorType {
  CLIENT
  CARRIER
  CUSTOMS_BROKER
  WAREHOUSE
  SUPPLIER
  OTHER
  GROUP_ENTITY
}

enum PaymentTerm {
  PREPAYMENT
  POSTPAYMENT
}

enum DealStage {
  NEW
  RATE_CALCULATION
  RATE_SENT
  AGREED
  IN_PROGRESS
  COMPLETED
  CLOSED
  REJECTED
}

enum DealRejectReason {
  EXPENSIVE
  TIMING
  COMPETITOR
  NO_CONTACT
  OTHER
}

enum TransportationStatus {
  REQUEST_ACCEPTED
  CARGO_PICKED
  IN_TRANSIT
  CUSTOMS
  DELIVERED
  CLOSED
}

enum TransportMode {
  AUTO
  RAIL
  SEA
  AIR
  MULTIMODAL
}

enum LegTransportMode {
  AUTO
  RAIL
  SEA
  AIR
  BROKER
}

enum LegStatus {
  WAITING
  IN_PROGRESS
  DONE
}

model User {
  id                         String                      @id @default(cuid())
  fullName                   String                      @map("full_name")
  email                      String                      @unique
  phone                      String?
  passwordHash               String                      @map("password_hash")
  departmentId               String?                     @map("department_id")
  isActive                   Boolean                     @default(true) @map("is_active")
  createdAt                  DateTime                    @default(now()) @map("created_at")
  updatedAt                  DateTime                    @updatedAt @map("updated_at")
  motivationRatePercent      Decimal?                    @map("motivation_rate_percent") @db.Decimal(5, 2)
  department                 Department?                 @relation(fields: [departmentId], references: [id])
  roles                      UserRole[]
  auditLogs                  AuditLog[]
  responsibleDeals           Deal[]
  logistTransportations      Transportation[]            @relation("TransportationLogist")
  transportationStatusEvents TransportationStatusEvent[] @relation("TransportationStatusSetBy")
  tableSettings              UserTableSettings[]
  createdLegalEntityTaxRates LegalEntityTaxRate[]        @relation("LegalEntityTaxRateCreatedBy")
  createdExchangeRates       ExchangeRate[]              @relation("ExchangeRateCreatedBy")
  createdInvoicePayments     InvoicePayment[]            @relation("InvoicePaymentCreatedBy")
  createdPaymentRequests     PaymentRequest[]            @relation("PaymentRequestCreatedBy")
  approvedPaymentRequests    PaymentRequest[]            @relation("PaymentRequestApprovedBy")
  paidPaymentRequests        PaymentRequest[]            @relation("PaymentRequestPaidBy")
  generatedDocuments         GeneratedDocument[]         @relation("GeneratedDocumentGeneratedBy")
  notifications              Notification[]
  notificationPreferences    NotificationPreference[]
  leads                      Lead[]
  leadActivities             LeadActivity[]
  leadImportBatches          LeadImportBatch[]
  whatsappMessages           WhatsAppMessage[]           @relation("WhatsAppMessageAuthor")
  attachments                Attachment[]                @relation("AttachmentUploadedBy")
  createdContracts           Contract[]                  @relation("ContractCreatedBy")

  @@map("users")
}

model UserTableSettings {
  id       String @id @default(cuid())
  userId   String @map("user_id")
  tableKey String @map("table_key")
  columns  Json
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, tableKey])
  @@map("user_table_settings")
}

model Role {
  id    String     @id @default(cuid())
  code  String     @unique
  name  String
  users UserRole[]

  @@map("roles")
}

model UserRole {
  id     String @id @default(cuid())
  userId String @map("user_id")
  roleId String @map("role_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@map("user_roles")
}

model Department {
  id    String @id @default(cuid())
  name  String @unique
  users User[]
  deals Deal[]
  leads Lead[]

  @@map("departments")
}

model LegalEntity {
  id                     String                  @id @default(cuid())
  name                   String
  numberingPrefix        String                  @unique @map("numbering_prefix")
  bin                    String?
  legalAddress           String?                 @map("legal_address")
  taxRegime              TaxRegime               @default(GENERAL) @map("tax_regime")
  isActive               Boolean                 @default(true) @map("is_active")
  contractorId           String?                 @unique @map("contractor_id")
  legalForm              String?                 @map("legal_form")
  bankName               String?                 @map("bank_name")
  bankAccount            String?                 @map("bank_account")
  bankBik                String?                 @map("bank_bik")
  signerPosition         String?                 @map("signer_position")
  signerFullName         String?                 @map("signer_full_name")
  signerShortName        String?                 @map("signer_short_name")
  signBasis              String?                 @map("sign_basis")
  talonNumber            String?                 @map("talon_number")
  phone                  String?
  email                  String?
  createdAt              DateTime                @default(now()) @map("created_at")
  updatedAt              DateTime                @updatedAt @map("updated_at")
  contractor             Contractor?             @relation(fields: [contractorId], references: [id], onDelete: SetNull)
  deals                  Deal[]
  dealNumberSequences    DealNumberSequence[]
  taxRates               LegalEntityTaxRate[]
  invoices               Invoice[]
  invoiceSequences       InvoiceNumberSequence[]
  paymentRequestsAsPayer PaymentRequest[]        @relation("PaymentRequestPayerLegalEntity")
  generatedDocuments     GeneratedDocument[]
  contracts              Contract[]

  @@map("legal_entities")
}

model LegalEntityTaxRate {
  id              String      @id @default(cuid())
  legalEntityId   String      @map("legal_entity_id")
  kind            TaxRateKind
  ratePercent     Decimal     @map("rate_percent") @db.Decimal(5, 2)
  isVatPayer      Boolean?    @map("is_vat_payer")
  effectiveFrom   DateTime    @map("effective_from") @db.Date
  note            String?
  createdAt       DateTime    @default(now()) @map("created_at")
  createdByUserId String?     @map("created_by_user_id")
  legalEntity     LegalEntity @relation(fields: [legalEntityId], references: [id], onDelete: Cascade)
  createdBy       User?       @relation("LegalEntityTaxRateCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@unique([legalEntityId, kind, effectiveFrom])
  @@index([legalEntityId, kind, effectiveFrom])
  @@map("legal_entity_tax_rates")
}

model Currency {
  code            String           @id @db.VarChar(3)
  name            String
  isBase          Boolean          @default(false) @map("is_base")
  isActive        Boolean          @default(true) @map("is_active")
  exchangeRates   ExchangeRate[]
  invoices        Invoice[]
  paymentRequests PaymentRequest[]

  @@map("currencies")
}

model ExchangeRate {
  currencyCode    String     @map("currency_code") @db.VarChar(3)
  rateDate        DateTime   @map("rate_date") @db.Date
  rate            Decimal    @db.Decimal(18, 6)
  source          RateSource
  createdByUserId String?    @map("created_by_user_id")
  createdAt       DateTime   @default(now()) @map("created_at")
  currency        Currency   @relation(fields: [currencyCode], references: [code], onDelete: Restrict)
  createdBy       User?      @relation("ExchangeRateCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@id([currencyCode, rateDate])
  @@index([currencyCode, rateDate])
  @@map("exchange_rates")
}

model AuditLog {
  id          String      @id @default(cuid())
  actorUserId String?     @map("actor_user_id")
  entityType  String      @map("entity_type")
  entityId    String      @map("entity_id")
  action      AuditAction
  changes     Json?
  createdAt   DateTime    @default(now()) @map("created_at")
  actorUser   User?       @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@map("audit_logs")
}

model Contractor {
  id                 String                  @id @default(cuid())
  name               String
  types              ContractorType[]
  bin                String?
  country            String?
  legalAddress       String?                 @map("legal_address")
  paymentTerm        PaymentTerm?            @map("payment_term")
  postpaymentDays    Int?                    @map("postpayment_days")
  notes              String?
  isProblem          Boolean                 @default(false) @map("is_problem")
  problemComment     String?                 @map("problem_comment")
  isBlacklisted      Boolean                 @default(false) @map("is_blacklisted")
  blacklistReason    String?                 @map("blacklist_reason")
  legalForm          String?                 @map("legal_form")
  signerPosition     String?                 @map("signer_position")
  signerFullName     String?                 @map("signer_full_name")
  signerShortName    String?                 @map("signer_short_name")
  signBasis          String?                 @map("sign_basis")
  talonNumber        String?                 @map("talon_number")
  phone              String?
  email              String?
  deletedAt          DateTime?               @map("deleted_at")
  createdAt          DateTime                @default(now()) @map("created_at")
  updatedAt          DateTime                @updatedAt @map("updated_at")
  contacts           ContractorContact[]
  bankAccounts       ContractorBankAccount[]
  deals              Deal[]
  transportationLegs TransportationLeg[]     @relation("TransportationLegSubcontractor")
  clientInvoices     Invoice[]
  paymentRequests    PaymentRequest[]        @relation("PaymentRequestPayee")
  contracts          Contract[]
  legalEntity        LegalEntity?
  generatedDocuments GeneratedDocument[]
  matchedByLeads     Lead[]                  @relation("LeadMatchedContractor")
  convertedFromLeads Lead[]                  @relation("LeadConvertedContractor")
  whatsappMessages   WhatsAppMessage[]

  @@map("contractors")
}

model Deal {
  id                 String              @id @default(cuid())
  number             String              @unique
  legalEntityId      String              @map("legal_entity_id")
  clientId           String              @map("client_id")
  responsibleId      String              @map("responsible_id")
  departmentId       String?             @map("department_id")
  stage              DealStage           @default(NEW)
  rejectReason       DealRejectReason?   @map("reject_reason")
  rejectComment      String?             @map("reject_comment")
  notes              String?
  deletedAt          DateTime?           @map("deleted_at")
  createdAt          DateTime            @default(now()) @map("created_at")
  updatedAt          DateTime            @updatedAt @map("updated_at")
  legalEntity        LegalEntity         @relation(fields: [legalEntityId], references: [id])
  client             Contractor          @relation(fields: [clientId], references: [id])
  responsible        User                @relation(fields: [responsibleId], references: [id])
  department         Department?         @relation(fields: [departmentId], references: [id])
  transportations    Transportation[]
  generatedDocuments GeneratedDocument[]
  convertedFromLead  Lead?

  @@map("deals")
}

model Transportation {
  id                    String                      @id @default(cuid())
  number                String                      @unique
  dealId                String                      @map("deal_id")
  sequenceInDeal        Int                         @map("sequence_in_deal")
  logistId              String                      @map("logist_id")
  status                TransportationStatus        @default(REQUEST_ACCEPTED)
  isMultiLeg            Boolean                     @default(false) @map("is_multi_leg")
  cargoName             String?                     @map("cargo_name")
  placesCount           Int?                        @map("places_count")
  placesUnit            String?                     @map("places_unit")
  weightKg              Decimal?                    @map("weight_kg") @db.Decimal(14, 3)
  volumeM3              Decimal?                    @map("volume_m3") @db.Decimal(14, 3)
  cargoValue            Decimal?                    @map("cargo_value") @db.Decimal(18, 2)
  cargoValueCurrency    String?                     @map("cargo_value_currency") @db.VarChar(3)
  isDangerous           Boolean                     @default(false) @map("is_dangerous")
  isTempControlled      Boolean                     @default(false) @map("is_temp_controlled")
  originPoint           String                      @map("origin_point")
  destinationPoint      String                      @map("destination_point")
  isDomestic            Boolean?                    @map("is_domestic")
  transportMode         TransportMode               @map("transport_mode")
  clientRate            Decimal?                    @map("client_rate") @db.Decimal(18, 2)
  clientRateCurrency    String?                     @map("client_rate_currency") @db.VarChar(3)
  plannedDeliveryDate   DateTime?                   @map("planned_delivery_date") @db.Date
  pickupEventDate       DateTime?                   @map("pickup_event_date") @db.Date
  unloadingEventDate    DateTime?                   @map("unloading_event_date") @db.Date
  actualDeliveryDate    DateTime?                   @map("actual_delivery_date") @db.Date
  shipperName           String?                     @map("shipper_name")
  consigneeName         String?                     @map("consignee_name")
  loadingAddress        String?                     @map("loading_address")
  loadingDateTime       DateTime?                   @map("loading_date_time")
  loadingContactName    String?                     @map("loading_contact_name")
  loadingContactPhone   String?                     @map("loading_contact_phone")
  unloadingAddress      String?                     @map("unloading_address")
  unloadingContactName  String?                     @map("unloading_contact_name")
  unloadingContactPhone String?                     @map("unloading_contact_phone")
  bodyType              String?                     @map("body_type")
  accompanyingDocs      String[]                    @default([]) @map("accompanying_docs")
  specialConditions     String?                     @map("special_conditions")
  deletedAt             DateTime?                   @map("deleted_at")
  createdAt             DateTime                    @default(now()) @map("created_at")
  updatedAt             DateTime                    @updatedAt @map("updated_at")
  deal                  Deal                        @relation(fields: [dealId], references: [id])
  logist                User                        @relation("TransportationLogist", fields: [logistId], references: [id])
  legs                  TransportationLeg[]
  statusEvents          TransportationStatusEvent[]
  invoices              Invoice[]
  paymentRequests       PaymentRequest[]
  generatedDocuments    GeneratedDocument[]

  @@unique([dealId, sequenceInDeal])
  @@index([logistId])
  @@index([status])
  @@map("transportations")
}

model TransportationLeg {
  id                        String           @id @default(cuid())
  transportationId          String           @map("transportation_id")
  orderIndex                Int              @map("order_index")
  fromPoint                 String           @map("from_point")
  toPoint                   String           @map("to_point")
  mode                      LegTransportMode
  subcontractorId           String?          @map("subcontractor_id")
  subcontractorRate         Decimal?         @map("subcontractor_rate") @db.Decimal(18, 2)
  subcontractorRateCurrency String?          @map("subcontractor_rate_currency") @db.VarChar(3)
  plannedStartDate          DateTime?        @map("planned_start_date") @db.Date
  plannedEndDate            DateTime?        @map("planned_end_date") @db.Date
  actualStartDate           DateTime?        @map("actual_start_date") @db.Date
  actualEndDate             DateTime?        @map("actual_end_date") @db.Date
  vehicleNumber             String?          @map("vehicle_number")
  trailerNumber             String?          @map("trailer_number")
  status                    LegStatus        @default(WAITING)
  driverFullName            String?          @map("driver_full_name")
  driverPhone               String?          @map("driver_phone")
  driverIin                 String?          @map("driver_iin")
  driverLicenseNumber       String?          @map("driver_license_number")
  driverLicenseDate         DateTime?        @map("driver_license_date") @db.Date
  driverLicenseIssuer       String?          @map("driver_license_issuer")
  transportation            Transportation   @relation(fields: [transportationId], references: [id], onDelete: Cascade)
  subcontractor             Contractor?      @relation("TransportationLegSubcontractor", fields: [subcontractorId], references: [id])
  paymentRequests           PaymentRequest[]

  @@unique([transportationId, orderIndex])
  @@index([subcontractorId])
  @@map("transportation_legs")
}

model TransportationStatusEvent {
  id               String                @id @default(cuid())
  transportationId String                @map("transportation_id")
  fromStatus       TransportationStatus? @map("from_status")
  toStatus         TransportationStatus  @map("to_status")
  isRollback       Boolean               @default(false) @map("is_rollback")
  eventDate        DateTime?             @map("event_date") @db.Date
  setAt            DateTime              @default(now()) @map("set_at")
  setById          String                @map("set_by_id")
  createdAt        DateTime              @default(now()) @map("created_at")
  transportation   Transportation        @relation(fields: [transportationId], references: [id], onDelete: Cascade)
  setBy            User                  @relation("TransportationStatusSetBy", fields: [setById], references: [id])

  @@index([transportationId, setAt])
  @@map("transportation_status_events")
}

model DealNumberSequence {
  id            String      @id @default(cuid())
  legalEntityId String      @map("legal_entity_id")
  year          Int
  lastNumber    Int         @map("last_number")
  legalEntity   LegalEntity @relation(fields: [legalEntityId], references: [id], onDelete: Cascade)

  @@unique([legalEntityId, year])
  @@map("deal_number_sequences")
}

model InvoiceNumberSequence {
  id            String      @id @default(cuid())
  legalEntityId String      @map("legal_entity_id")
  year          Int
  lastNumber    Int         @map("last_number")
  legalEntity   LegalEntity @relation(fields: [legalEntityId], references: [id], onDelete: Cascade)

  @@unique([legalEntityId, year])
  @@map("invoice_number_sequences")
}

model Invoice {
  id               String           @id @default(cuid())
  number           String           @unique
  transportationId String           @map("transportation_id")
  legalEntityId    String           @map("legal_entity_id")
  clientId         String           @map("client_id")
  currencyCode     String           @map("currency_code") @db.VarChar(3)
  issueDate        DateTime         @map("issue_date") @db.Date
  dueDate          DateTime         @map("due_date") @db.Date
  status           InvoiceStatus    @default(ISSUED)
  isIntragroup     Boolean          @default(false) @map("is_intragroup")
  notes            String?
  deletedAt        DateTime?        @map("deleted_at")
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")
  transportation   Transportation   @relation(fields: [transportationId], references: [id], onDelete: Restrict)
  legalEntity      LegalEntity      @relation(fields: [legalEntityId], references: [id], onDelete: Restrict)
  client           Contractor       @relation(fields: [clientId], references: [id], onDelete: Restrict)
  currency         Currency         @relation(fields: [currencyCode], references: [code], onDelete: Restrict)
  lines            InvoiceLine[]
  payments         InvoicePayment[]
  reimbursementFor PaymentRequest?

  @@index([clientId])
  @@index([legalEntityId])
  @@index([status])
  @@index([isIntragroup])
  @@map("invoices")
}

model InvoiceLine {
  id             String   @id @default(cuid())
  invoiceId      String   @map("invoice_id")
  sortOrder      Int      @map("sort_order")
  serviceName    String   @map("service_name")
  quantity       Decimal  @db.Decimal(12, 3)
  unitPrice      Decimal  @map("unit_price") @db.Decimal(18, 2)
  hasVat         Boolean  @map("has_vat")
  vatRatePercent Decimal? @map("vat_rate_percent") @db.Decimal(5, 2)
  invoice        Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@unique([invoiceId, sortOrder])
  @@map("invoice_lines")
}

model InvoicePayment {
  id                 String    @id @default(cuid())
  invoiceId          String    @map("invoice_id")
  paymentDate        DateTime  @map("payment_date") @db.Date
  amount             Decimal   @db.Decimal(18, 2)
  manualExchangeRate Decimal?  @map("manual_exchange_rate") @db.Decimal(18, 6)
  note               String?
  createdByUserId    String    @map("created_by_user_id")
  createdAt          DateTime  @default(now()) @map("created_at")
  deletedAt          DateTime? @map("deleted_at")
  invoice            Invoice   @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  createdBy          User      @relation("InvoicePaymentCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)

  @@index([invoiceId, paymentDate])
  @@map("invoice_payments")
}

model PaymentRequest {
  id                     String               @id @default(cuid())
  transportationId       String               @map("transportation_id")
  legId                  String?              @map("leg_id")
  payeeContractorId      String               @map("payee_contractor_id")
  amount                 Decimal              @db.Decimal(18, 2)
  currencyCode           String               @map("currency_code") @db.VarChar(3)
  dueDate                DateTime             @map("due_date") @db.Date
  purpose                String
  status                 PaymentRequestStatus @default(REQUESTED)
  approvedByUserId       String?              @map("approved_by_user_id")
  approvedAt             DateTime?            @map("approved_at")
  paidByUserId           String?              @map("paid_by_user_id")
  paidAt                 DateTime?            @map("paid_at")
  actualExchangeRate     Decimal?             @map("actual_exchange_rate") @db.Decimal(18, 6)
  payerLegalEntityId     String?              @map("payer_legal_entity_id")
  reimbursementInvoiceId String?              @unique @map("reimbursement_invoice_id")
  deletedAt              DateTime?            @map("deleted_at")
  createdByUserId        String               @map("created_by_user_id")
  createdAt              DateTime             @default(now()) @map("created_at")
  updatedAt              DateTime             @updatedAt @map("updated_at")
  transportation         Transportation       @relation(fields: [transportationId], references: [id], onDelete: Restrict)
  leg                    TransportationLeg?   @relation(fields: [legId], references: [id], onDelete: SetNull)
  payeeContractor        Contractor           @relation("PaymentRequestPayee", fields: [payeeContractorId], references: [id], onDelete: Restrict)
  currency               Currency             @relation(fields: [currencyCode], references: [code], onDelete: Restrict)
  createdBy              User                 @relation("PaymentRequestCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  approvedBy             User?                @relation("PaymentRequestApprovedBy", fields: [approvedByUserId], references: [id], onDelete: SetNull)
  paidBy                 User?                @relation("PaymentRequestPaidBy", fields: [paidByUserId], references: [id], onDelete: SetNull)
  payerLegalEntity       LegalEntity?         @relation("PaymentRequestPayerLegalEntity", fields: [payerLegalEntityId], references: [id], onDelete: SetNull)
  reimbursementInvoice   Invoice?             @relation(fields: [reimbursementInvoiceId], references: [id], onDelete: SetNull)

  @@index([transportationId])
  @@index([legId])
  @@index([payeeContractorId])
  @@index([status])
  @@index([payerLegalEntityId])
  @@index([dueDate])
  @@map("payment_requests")
}

model ContractorContact {
  id           String     @id @default(cuid())
  contractorId String     @map("contractor_id")
  fullName     String     @map("full_name")
  position     String?
  phone        String?
  email        String?
  whatsapp     String?
  contractor   Contractor @relation(fields: [contractorId], references: [id], onDelete: Cascade)

  @@map("contractor_contacts")
}

model ContractorBankAccount {
  id            String     @id @default(cuid())
  contractorId  String     @map("contractor_id")
  bankName      String     @map("bank_name")
  accountNumber String     @map("account_number")
  currency      String
  bik           String?
  isPrimary     Boolean    @default(false) @map("is_primary")
  notes         String?
  contractor    Contractor @relation(fields: [contractorId], references: [id], onDelete: Cascade)

  @@map("contractor_bank_accounts")
}

model MotivationSettings {
  id               String   @id @default(cuid())
  bonusRatePercent Decimal  @default(10) @map("bonus_rate_percent") @db.Decimal(5, 2)
  updatedAt        DateTime @updatedAt @map("updated_at")

  @@map("motivation_settings")
}

model Notification {
  id         String           @id @default(cuid())
  userId     String           @map("user_id")
  type       NotificationType
  title      String
  message    String
  entityType String           @map("entity_type")
  entityId   String           @map("entity_id")
  isRead     Boolean          @default(false) @map("is_read")
  createdAt  DateTime         @default(now()) @map("created_at")
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([type, entityId])
  @@map("notifications")
}

model NotificationPreference {
  id      String           @id @default(cuid())
  userId  String           @map("user_id")
  type    NotificationType
  enabled Boolean          @default(true)
  user    User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type])
  @@map("notification_preferences")
}

model NotificationSettings {
  id              String   @id @default(cuid())
  dealStalledDays Int      @default(3) @map("deal_stalled_days")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@map("notification_settings")
}

enum GeneratedDocumentType {
  CONTRACT
  TRANSPORT_REQUEST
  INVOICE
}

// Атомарный счётчик номеров документов. key уже содержит дату
// (напр. "TT-EX-2407/2026"), поэтому отдельного сброса "раз в день" не нужно —
// каждый день формирует свой ключ. Второй документ с тем же ключом за день
// получает суффикс "/2" (см. DocumentsService.nextDocumentNumber).
model DocumentNumberCounter {
  id    String @id @default(cuid())
  key   String @unique
  count Int    @default(0)

  @@map("document_number_counters")
}

// Документы не хранятся файлами — .docx пересобирается из данных сделки/
// перевозки при каждом скачивании (тот же принцип, что в исходном
// contract-generator). Здесь — только лёгкий журнал "кто/когда/какой номер".
model GeneratedDocument {
  id                String                @id @default(cuid())
  type              GeneratedDocumentType
  number            String
  dealId            String?               @map("deal_id")
  transportationId  String?               @map("transportation_id")
  contractorId      String?               @map("contractor_id")
  legalEntityId     String?               @map("legal_entity_id")
  generatedByUserId String                @map("generated_by_user_id")
  generatedAt       DateTime              @default(now()) @map("generated_at")
  deal              Deal?                 @relation(fields: [dealId], references: [id], onDelete: SetNull)
  transportation    Transportation?       @relation(fields: [transportationId], references: [id], onDelete: SetNull)
  contractor        Contractor?           @relation(fields: [contractorId], references: [id], onDelete: SetNull)
  legalEntity       LegalEntity?          @relation(fields: [legalEntityId], references: [id], onDelete: SetNull)
  generatedBy       User                  @relation("GeneratedDocumentGeneratedBy", fields: [generatedByUserId], references: [id], onDelete: Restrict)

  @@index([dealId])
  @@index([transportationId])
  @@index([contractorId])
  @@map("generated_documents")
}

// Лиды холодного обзвона хранятся отдельно от справочника контрагентов (ТЗ 4.9) —
// в контрагенты попадают только конвертированные, чтобы справочник не засорялся.
model LeadImportBatch {
  id                 String   @id @default(cuid())
  fileName           String   @map("file_name")
  importedByUserId   String   @map("imported_by_user_id")
  rowsTotal          Int      @map("rows_total")
  rowsCreated        Int      @map("rows_created")
  rowsExistingClient Int      @map("rows_existing_client")
  rowsDuplicateLead  Int      @map("rows_duplicate_lead")
  createdAt          DateTime @default(now()) @map("created_at")
  importedBy         User     @relation(fields: [importedByUserId], references: [id], onDelete: Restrict)
  leads              Lead[]

  @@map("lead_import_batches")
}

model Lead {
  id                    String                   @id @default(cuid())
  name                  String
  phone                 String?
  bin                   String?
  city                  String?
  contactName           String?                  @map("contact_name")
  email                 String?
  notes                 String?
  routeFrom             String?                  @map("route_from")
  routeTo               String?                  @map("route_to")
  cargoDescription      String?                  @map("cargo_description")
  sourcePage            String?                  @map("source_page")
  sourceLanguage        String?                  @map("source_language")
  utmSource             String?                  @map("utm_source")
  utmMedium             String?                  @map("utm_medium")
  utmCampaign           String?                  @map("utm_campaign")
  utmContent            String?                  @map("utm_content")
  utmTerm               String?                  @map("utm_term")
  source                LeadSource               @default(COLD_CALL_IMPORT)
  status                LeadStatus               @default(NEW)
  firstHandledAt        DateTime?                @map("first_handled_at")
  notInterestedReason   LeadNotInterestedReason? @map("not_interested_reason")
  notInterestedComment  String?                  @map("not_interested_comment")
  callBackAt            DateTime?                @map("call_back_at")
  notReachedAttempts    Int                      @default(0) @map("not_reached_attempts")
  isExistingClient      Boolean                  @default(false) @map("is_existing_client")
  matchedContractorId   String?                  @map("matched_contractor_id")
  responsibleId         String?                  @map("responsible_id")
  departmentId          String?                  @map("department_id")
  importBatchId         String?                  @map("import_batch_id")
  convertedDealId       String?                  @unique @map("converted_deal_id")
  convertedContractorId String?                  @map("converted_contractor_id")
  deletedAt             DateTime?                @map("deleted_at")
  createdAt             DateTime                 @default(now()) @map("created_at")
  updatedAt             DateTime                 @updatedAt @map("updated_at")
  responsible           User?                    @relation(fields: [responsibleId], references: [id], onDelete: SetNull)
  department            Department?              @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  importBatch           LeadImportBatch?         @relation(fields: [importBatchId], references: [id], onDelete: SetNull)
  matchedContractor     Contractor?              @relation("LeadMatchedContractor", fields: [matchedContractorId], references: [id], onDelete: SetNull)
  convertedContractor   Contractor?              @relation("LeadConvertedContractor", fields: [convertedContractorId], references: [id], onDelete: SetNull)
  convertedDeal         Deal?                    @relation(fields: [convertedDealId], references: [id], onDelete: SetNull)
  activities            LeadActivity[]

  @@index([responsibleId])
  @@index([departmentId])
  @@index([status])
  @@map("leads")
}

model LeadActivity {
  id         String     @id @default(cuid())
  leadId     String     @map("lead_id")
  userId     String     @map("user_id")
  fromStatus LeadStatus @map("from_status")
  toStatus   LeadStatus @map("to_status")
  comment    String
  callBackAt DateTime?  @map("call_back_at")
  createdAt  DateTime   @default(now()) @map("created_at")
  lead       Lead       @relation(fields: [leadId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([leadId, createdAt])
  @@map("lead_activities")
}

enum WhatsAppDirection {
  IN
  OUT
}

enum WhatsAppMessageStatus {
  PENDING
  SENT
  DELIVERED
  READ
  FAILED
  RECEIVED
}

// Заготовка интеграции с Wazzup (ТЗ 4.6.1) — переписка хранится отдельно от Lead/LeadActivity,
// так как это не касание по лиду, а сквозная история сообщений с контрагентом.
model WhatsAppTemplate {
  id        String            @id @default(cuid())
  title     String
  body      String
  isActive  Boolean           @default(true) @map("is_active")
  createdAt DateTime          @default(now()) @map("created_at")
  updatedAt DateTime          @updatedAt @map("updated_at")
  messages  WhatsAppMessage[]

  @@map("whatsapp_templates")
}

model WhatsAppMessage {
  id              String                @id @default(cuid())
  direction       WhatsAppDirection
  channelId       String?               @map("channel_id")
  chatId          String                @map("chat_id")
  contactName     String?               @map("contact_name")
  contractorId    String?               @map("contractor_id")
  text            String
  status          WhatsAppMessageStatus
  wazzupMessageId String?               @unique @map("wazzup_message_id")
  templateId      String?               @map("template_id")
  authorUserId    String?               @map("author_user_id")
  createdAt       DateTime              @default(now()) @map("created_at")
  updatedAt       DateTime              @updatedAt @map("updated_at")
  contractor      Contractor?           @relation(fields: [contractorId], references: [id], onDelete: SetNull)
  template        WhatsAppTemplate?     @relation(fields: [templateId], references: [id], onDelete: SetNull)
  author          User?                 @relation("WhatsAppMessageAuthor", fields: [authorUserId], references: [id], onDelete: SetNull)

  @@index([contractorId, createdAt])
  @@index([chatId, createdAt])
  @@map("whatsapp_messages")
}

// Файловое хранилище (раздел 4.5 ТЗ): сами файлы лежат на диске в томе,
// в базе — только метаданные и привязка к карточке. Имя на диске генерируется
// системой (storedName), оригинальное имя показывается пользователю —
// так исключается подстановка пути через имя файла.
enum AttachmentEntityType {
  DEAL
  TRANSPORTATION
  CONTRACTOR
  INVOICE
  PAYMENT_REQUEST
  CONTRACT
}

model Attachment {
  id           String               @id @default(cuid())
  entityType   AttachmentEntityType @map("entity_type")
  entityId     String               @map("entity_id")
  fileName     String               @map("file_name")
  storedName   String               @unique @map("stored_name")
  mimeType     String               @map("mime_type")
  sizeBytes    Int                  @map("size_bytes")
  description  String?
  uploadedById String               @map("uploaded_by_id")
  uploadedAt   DateTime             @default(now()) @map("uploaded_at")
  deletedAt    DateTime?            @map("deleted_at")
  uploadedBy   User                 @relation("AttachmentUploadedBy", fields: [uploadedById], references: [id], onDelete: Restrict)

  @@index([entityType, entityId])
  @@map("attachments")
}

// Реестр договоров с контрагентом (раздел 4.2 ТЗ). У одной пары
// «юрлицо группы ↔ контрагент» может быть несколько договоров, поэтому
// уникальности по паре нет. Номер вводится вручную (бумажные договоры
// сохраняют свои номера) либо подставляется при генерации из системы.
enum ContractStatus {
  ACTIVE
  EXPIRED
  TERMINATED
}

model Contract {
  id               String         @id @default(cuid())
  contractorId     String         @map("contractor_id")
  legalEntityId    String         @map("legal_entity_id")
  number           String
  signedAt         DateTime       @map("signed_at") @db.Date
  validUntil       DateTime?      @map("valid_until") @db.Date
  status           ContractStatus @default(ACTIVE)
  terminatedAt     DateTime?      @map("terminated_at") @db.Date
  subject          String?
  notes            String?
  expiryNotifiedAt DateTime?      @map("expiry_notified_at")
  createdById      String         @map("created_by_id")
  deletedAt        DateTime?      @map("deleted_at")
  createdAt        DateTime       @default(now()) @map("created_at")
  updatedAt        DateTime       @updatedAt @map("updated_at")
  contractor       Contractor     @relation(fields: [contractorId], references: [id], onDelete: Restrict)
  legalEntity      LegalEntity    @relation(fields: [legalEntityId], references: [id], onDelete: Restrict)
  createdBy        User           @relation("ContractCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([contractorId])
  @@index([legalEntityId])
  @@index([validUntil])
  @@map("contracts")
}
