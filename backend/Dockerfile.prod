# syntax=docker/dockerfile:1

FROM node:22-bookworm-slim AS deps

RUN apt-get update \
    && apt-get install -y --no-install-recommends openssl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY package.json package-lock.json ./
COPY backend/package.json ./backend/package.json
COPY frontend/package.json ./frontend/package.json
RUN npm ci --workspace @ava-crm/backend

FROM deps AS build

COPY backend/nest-cli.json backend/tsconfig.json backend/tsconfig.build.json ./backend/
COPY backend/prisma ./backend/prisma
COPY backend/src ./backend/src
RUN npm run prisma:generate --workspace @ava-crm/backend \
    && npm run build --workspace @ava-crm/backend

# Одноразовый target со средствами разработки нужен только для штатного Prisma seed.
# Рабочий backend-контейнер строится из target runtime и этих зависимостей не содержит.
FROM build AS seed

COPY --chmod=755 backend/docker-entrypoint.prod.sh /usr/local/bin/backend-entrypoint
ENTRYPOINT ["/usr/local/bin/backend-entrypoint"]
CMD ["seed"]

FROM build AS prod-deps

RUN npm prune --omit=dev --workspace @ava-crm/backend \
    && npm cache clean --force

FROM node:22-bookworm-slim AS runtime

RUN apt-get update \
    && apt-get install -y --no-install-recommends openssl \
    && rm -rf /var/lib/apt/lists/*

ENV NODE_ENV=production
WORKDIR /app

COPY --from=prod-deps /app/node_modules ./node_modules
COPY --from=build /app/backend/package.json ./backend/package.json
COPY --from=build /app/backend/dist ./backend/dist
COPY --from=build /app/backend/prisma ./backend/prisma
COPY --chmod=755 backend/docker-entrypoint.prod.sh /usr/local/bin/backend-entrypoint

RUN mkdir -p /app/backend/uploads \
    && chown -R node:node /app/backend

WORKDIR /app/backend
USER node
EXPOSE 3000

ENTRYPOINT ["/usr/local/bin/backend-entrypoint"]
CMD ["start"]
