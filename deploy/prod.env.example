# Шаблон переменных окружения для боевого сервера.
# Скопируйте в файл ".env" в корне проекта (docker compose читает .env автоматически)
# и замените все значения-примеры. Файл .env не должен попадать в git.

# --- Домен и сертификат ---
# Домен, на котором будет открываться CRM (например, crm.ava-solution.kz).
DOMAIN=crm.example.kz
# Почта для регистрации в Let's Encrypt — на неё придёт письмо, если сертификат
# перестанет продлеваться.
LETSENCRYPT_EMAIL=admin@example.kz
# Режим nginx: acme (только приём заявки на сертификат, для самого первого запуска),
# http (без TLS, для теста без домена), tls (обычный боевой режим с HTTPS).
# Порядок переключения режимов — в deploy/README.md.
NGINX_MODE=acme
# Максимальный размер запроса (загрузка вложений) — держите в паре с MAX_UPLOAD_MB ниже.
NGINX_MAX_BODY_SIZE=30m

# --- База данных ---
POSTGRES_DB=ava_crm
POSTGRES_USER=ava_crm
POSTGRES_PASSWORD=замените-на-длинный-случайный-пароль

# --- Backend ---
# Укажите домен CRM со схемой HTTPS, без пути и завершающего слеша.
# Несколько разрешённых источников можно перечислить через запятую.
CORS_ORIGINS=https://crm.example.kz
JWT_SECRET=замените-на-длинную-случайную-строку
MAX_UPLOAD_MB=25

# --- Резервное копирование ---
# Сколько дней хранить ежедневные бэкапы базы и файлов (раздел 5.5 ТЗ).
# Копии складываются в ./backups на сервере, см. deploy/README.md.
BACKUP_RETENTION_DAYS=30

# Опционально: администратор для первого запуска (используется только один раз,
# командой из deploy/README.md, шаг "первый запуск").
ADMIN_SEED_EMAIL=admin@example.kz
ADMIN_SEED_PASSWORD=замените-на-сильный-пароль

# Опционально: интеграция WhatsApp через Wazzup (раздел 4.6.1 ТЗ). Без них экраны
# WhatsApp работают в режиме "не настроено".
WAZZUP_API_KEY=
WAZZUP_CHANNEL_ID=
# Придумайте длинную случайную строку — она же прописывается в Wazzup как часть URL
# вебхука (https://ВАШ_ДОМЕН/api/webhooks/wazzup/ЗНАЧЕНИЕ).
WAZZUP_WEBHOOK_SECRET=

# Опционально: приём заявок с сайта ava-solution.kz (раздел 4.6.3 ТЗ). Придумайте
# длинную случайную строку — этим же значением сайт подписывает каждый запрос.
WEBSITE_LEADS_WEBHOOK_SECRET=
